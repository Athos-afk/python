# Questão 1 - Números de 1 a 20

# Variável para contar a quantidade de números pares
qtd_pares = 0

print("--- Números de 1 a 20 ---")
# Estrutura for para percorrer os números de 1 a 20
for i in range(1, 21):
    # Verifica se o número é par
    if i % 2 == 0:
        print(f"{i} - É par")
        qtd_pares += 1
    else:
        print(f"{i}")

# Apresenta a quantidade total de números pares
print(f"\nQuantidade de números pares encontrados: {qtd_pares}")
